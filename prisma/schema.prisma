generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}




// schema.prisma


model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(ADMIN)
  password  String
  isActive  Boolean  @default(true)
  apiLimits Json?
  apiUsage  Json?
  featureFlags Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedInquiries Inquiry[]
  auditLogs       AuditLog[]
}

enum Role {
  ADMIN
  SALES
  SUPERADMIN
}

model Product {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String
  specs       Json
  images      ImageAsset[]
  featured    Boolean     @default(false)
  showOnHome  Boolean     @default(false)
  metaSEO     Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inquiries   Inquiry[]
}

model Inquiry {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  name       String
  email      String
  phone      String?
  message    String
  status     InquiryStatus @default(NEW)
  assignedTo User?    @relation(fields: [assignedToId], references: [id])
  assignedToId String?
  notes      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  type      AgentType
  enabled   Boolean  @default(true)
  config    Json?
  logs      Json[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AgentType {
  LEAD_GEN
  LINKEDIN
  EMAIL_RESPONDER
  CHAT_SUPPORT
  SEO
  IMAGE_FIXER
}

model UiContent {
  id       String   @id @default(cuid())
  header   String?
  sliders  Json?    // Array of {image, title, link}
  footer   Json?
  promos   Json?
  updatedAt DateTime @updatedAt
}

model ImageAsset {
  id        String   @id @default(cuid())
  filename  String
  altText   String?
  optimized Boolean  @default(false)
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  userId    String?     // Optional: if notification is specific to a user
  read      Boolean          @default(false)
  metadata  Json?            // Store related entity ID (e.g., inquiryId)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum NotificationType {
  INQUIRY
  AGENT_COMPLETE
  AGENT_ERROR
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     Json?
  ip          String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model FeatureToggle {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  isEnabled   Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
}
